# Demosaic node: unit / tiling / cache tests (ctest demosaic.*), the evaluation tool against LibRaw (not a test: needs the sample files),
# and with -DDAPPLE_GPU=ON the GPU parity tests (exit code 77 = no device). docs/engine/pipeline-architecture.md section 32.
add_executable(dapple_demosaic_eval ${CMAKE_CURRENT_LIST_DIR}/demosaic_eval.cpp)
target_link_libraries(dapple_demosaic_eval PRIVATE dapple_core dapple_stb)
target_include_directories(dapple_demosaic_eval PRIVATE ${PROJECT_SOURCE_DIR}/core ${PROJECT_SOURCE_DIR}/core/include)
if(NOT MSVC)
  target_compile_options(dapple_demosaic_eval PRIVATE -Wall -Wextra -Wno-unused-parameter)
endif()

add_executable(dapple_demosaic_tests ${CMAKE_CURRENT_LIST_DIR}/demosaic_tests.cpp)
target_link_libraries(dapple_demosaic_tests PRIVATE dapple_core)
target_include_directories(dapple_demosaic_tests PRIVATE ${PROJECT_SOURCE_DIR}/core ${PROJECT_SOURCE_DIR}/core/include ${CMAKE_CURRENT_LIST_DIR})
if(NOT MSVC)
  target_compile_options(dapple_demosaic_tests PRIVATE -Wall -Wextra -Wno-unused-parameter)
endif()
foreach(_t flat edges zoneplate hotpixel hotfilter clip tiles threads cache)
  add_test(NAME demosaic.${_t} COMMAND dapple_demosaic_tests ${_t} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
  set_tests_properties(demosaic.${_t} PROPERTIES TIMEOUT 600)
endforeach()
# the decoder's mosaic path on the public sample files (skipped, exit 77, when build/rawsamples is absent)
foreach(_t wire_region wire_anchor wire_anchor_fast wire_preview wire_cache wire_cancel)
  add_test(NAME demosaic.${_t} COMMAND dapple_demosaic_tests ${_t} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
  set_tests_properties(demosaic.${_t} PROPERTIES TIMEOUT 900 SKIP_RETURN_CODE 77)
endforeach()
if(TARGET dapple_gpu)
  target_link_libraries(dapple_demosaic_tests PRIVATE dapple_gpu)
  foreach(_t gpu_parity gpu_tiles gpu_real wire_gpu)
    add_test(NAME demosaic.${_t} COMMAND dapple_demosaic_tests ${_t} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
    set_tests_properties(demosaic.${_t} PROPERTIES TIMEOUT 900 SKIP_RETURN_CODE 77)
    if(EXISTS "${DAPPLE_SWIFTSHADER_LIB}" AND DEFINED _ss_icd)
      add_test(NAME demosaic.${_t}_swiftshader COMMAND dapple_demosaic_tests ${_t} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
      set_tests_properties(demosaic.${_t}_swiftshader PROPERTIES TIMEOUT 1800 SKIP_RETURN_CODE 77
        ENVIRONMENT "VK_DRIVER_FILES=${_ss_icd};VK_ICD_FILENAMES=${_ss_icd};DAPPLE_GPU_SOFTWARE=1")
    endif()
  endforeach()
endif()
if(TARGET dapple_gpu)
  target_link_libraries(dapple_demosaic_eval PRIVATE dapple_gpu)
endif()
# GLES 3.1 through ANGLE (Android SDK emulator copy, docs/legal/gles-toolchain.md): the same kernels translated to ESSL 310 by dapple_shaderc
if(TARGET dapple_gpu AND TARGET dapple_hal_gles)
  set(_dm_angle "${PROJECT_SOURCE_DIR}/tools/android-sdk/emulator/lib64/gles_angle")
  if(EXISTS "${_dm_angle}/libEGL.dll" OR EXISTS "${_dm_angle}/libEGL.so")
    foreach(_b vulkan swiftshader)
      foreach(_t gpu_parity gpu_tiles gpu_real)
        add_test(NAME demosaic.${_t}_gles_angle_${_b} COMMAND dapple_demosaic_tests ${_t} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
        set_tests_properties(demosaic.${_t}_gles_angle_${_b} PROPERTIES TIMEOUT 1800 SKIP_RETURN_CODE 77
          ENVIRONMENT "DAPPLE_ANGLE_DIR=${_dm_angle};DAPPLE_ANGLE_BACKEND=${_b};DAPPLE_GPU_SOFTWARE=1;DAPPLE_GPU_API=gles")
      endforeach()
    endforeach()
  endif()
endif()

# CPU-only build of the evaluation tool (no dapple_gpu dependency: quality work while the GPU executor is being edited)
add_executable(dapple_demosaic_eval_cpu ${CMAKE_CURRENT_LIST_DIR}/demosaic_eval.cpp)
target_link_libraries(dapple_demosaic_eval_cpu PRIVATE dapple_core dapple_stb)
target_include_directories(dapple_demosaic_eval_cpu PRIVATE ${PROJECT_SOURCE_DIR}/core ${PROJECT_SOURCE_DIR}/core/include)
