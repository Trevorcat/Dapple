#version 450
// End of a film frame: the film plane (display sRGB, unclamped) -> DisplayStages (master / RGB curves, look LUT) -> blend with the
// normal branch -> vignette -> clamp -> RGBA16F working image, or (last pass) the grain epilogue and the RGBA8 output.
//   DISP   the display stages are not the identity (curves in a buffer, the look LUT as a 3D image)
//   BLEND  film strength < 1: out = main + strength * (film - main), main = uM (the normal branch, same window as the output)
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16, local_size_x_id = 16, local_size_y_id = 17) in;
#include "common.glsl"

layout(constant_id = 12) const bool BLEND = false;
layout(constant_id = 13) const bool DISP = false;

layout(std140, binding = 0) uniform P {
  ivec4 a;      // dW, dH, origin x, y of this image in the picture
  vec4 geoB;    // ox0, oy0, stepX, stepY
  vec4 geoC;    // fullW, fullH, vignette, 0
  vec4 e;       // grain amp, grain period
  ivec4 f;      // origin x, y of the film image in the picture, mask of the non-identity curves (master, r, g, b), look LUT size (0 = none)
  vec4 g;       // blend strength, look LUT mix, curve samples, 0
  vec4 dmin;    // look LUT domain
  vec4 dmax;
} u;

layout(binding = 1) uniform sampler2D uF;
layout(binding = 2, rgba16f) uniform writeonly image2D uD;
layout(binding = 3, rgba8) uniform writeonly image2D uOut8;
layout(binding = 4) uniform sampler2D uM;                       // BLEND: the normal branch
layout(binding = 5, std430) readonly buffer Curves { float cv[]; };  // DISP: [4][samples]: master, red, green, blue
layout(binding = 6) uniform sampler3D uLut;                     // DISP: look LUT (r fastest), RGBA32F

// Renderer::Curve1D::operator()
float curveAt(int c, float x) {
  if (((u.f.z >> c) & 1) == 0) return x;
  const int n = int(u.g.z);
  const float fl = clamp(x, 0.0, 1.0) * float(n - 1);
  const int i = min(int(fl), n - 2);
  const float t = fl - float(i);
  const float lo = cv[c * n + i], hi = cv[c * n + i + 1];
  return lo + t * (hi - lo);
}
vec3 lutAt(int r, int g, int b) { return texelFetch(uLut, ivec3(r, g, b), 0).rgb; }
// Lut3D::apply (tetrahedral)
vec3 lutApply(vec3 e) {
  const int N = u.f.w;
  const float n = float(N - 1);
  const vec3 v = clamp((e - u.dmin.xyz) / (u.dmax.xyz - u.dmin.xyz), vec3(0.0), vec3(1.0)) * n;
  const ivec3 i0 = min(ivec3(v), ivec3(N - 2));
  const vec3 fr = v - vec3(i0);
  const ivec3 i1 = i0 + ivec3(1);
  const float fr_ = fr.x, fg = fr.y, fb = fr.z;
  const vec3 c000 = lutAt(i0.x, i0.y, i0.z), c111 = lutAt(i1.x, i1.y, i1.z);
  vec3 a, b;
  float w0, wa, wb, w1;
  if (fr_ > fg) {
    if (fg > fb) {
      a = lutAt(i1.x, i0.y, i0.z); b = lutAt(i1.x, i1.y, i0.z);
      w0 = 1.0 - fr_; wa = fr_ - fg; wb = fg - fb; w1 = fb;
    } else if (fr_ > fb) {
      a = lutAt(i1.x, i0.y, i0.z); b = lutAt(i1.x, i0.y, i1.z);
      w0 = 1.0 - fr_; wa = fr_ - fb; wb = fb - fg; w1 = fg;
    } else {
      a = lutAt(i0.x, i0.y, i1.z); b = lutAt(i1.x, i0.y, i1.z);
      w0 = 1.0 - fb; wa = fb - fr_; wb = fr_ - fg; w1 = fg;
    }
  } else {
    if (fb > fg) {
      a = lutAt(i0.x, i0.y, i1.z); b = lutAt(i0.x, i1.y, i1.z);
      w0 = 1.0 - fb; wa = fb - fg; wb = fg - fr_; w1 = fr_;
    } else if (fb > fr_) {
      a = lutAt(i0.x, i1.y, i0.z); b = lutAt(i0.x, i1.y, i1.z);
      w0 = 1.0 - fg; wa = fg - fb; wb = fb - fr_; w1 = fr_;
    } else {
      a = lutAt(i0.x, i1.y, i0.z); b = lutAt(i1.x, i1.y, i0.z);
      w0 = 1.0 - fg; wa = fg - fr_; wb = fr_ - fb; w1 = fb;
    }
  }
  return w0 * c000 + wa * a + wb * b + w1 * c111;
}
// Renderer::displayStages
vec3 displayStages(vec3 e) {
  e = vec3(curveAt(0, e.x), curveAt(0, e.y), curveAt(0, e.z));
  e = vec3(curveAt(1, e.x), curveAt(2, e.y), curveAt(3, e.z));
  if (u.f.w > 0 && u.g.y > 0.0) {
    const vec3 l = lutApply(e);
    e += (l - e) * u.g.y;
  }
  return e;
}

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.a.x || p.y >= u.a.y) return;
  const ivec2 q = p + u.a.zw;
  vec3 e = texelFetch(uF, q - u.f.xy, 0).rgb;
  if (DISP) e = displayStages(e);
  if (BLEND) {
    const vec3 m = texelFetch(uM, p, 0).rgb;
    e = m + u.g.x * (e - m);
  }
  const float vig = u.geoC.z;
  if (vig != 0.0) {
    const float cx = u.geoC.x * 0.5, cy = u.geoC.y * 0.5;
    const float px = u.geoB.x + (float(q.x) + 0.5) * u.geoB.z - 0.5;
    const float py = u.geoB.y + (float(q.y) + 0.5) * u.geoB.w - 0.5;
    const float dx = (px - cx) / cx, dy = (py - cy) / cy;
    const float f = smoothstep(0.35, 1.05, sqrt((dx * dx + dy * dy) * 0.5));
    e = vig < 0.0 ? e * (1.0 + vig * 0.6 * f) : e + (1.0 - e) * vig * 0.6 * f;
  }
  e = clamp(e, vec3(0.0), vec3(1.0));
  if (GRAIN) e = grainApply(e, q, u.e.x, u.e.y);
  if (LAST) imageStore(uOut8, p, pack8(e));
  else imageStore(uD, p, h16v(vec4(e, 1.0)));
}
