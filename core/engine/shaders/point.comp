#version 450
// Fused point-wise pass: geometry resampling (rotate/straighten/crop/flip, Catmull-Rom or exact index mapping)
// -> white balance * exposure gain -> tone table (luminance ratio, indexed by float bits) -> baked colour lattice
// (tetrahedral, sqrt-domain nodes; a coarse second lattice takes the pixels beyond the first one's range, where the CPU
// takes its exact path) -> vignette -> RGBA16F working image (and RGBA8 + grain when it is the last pass).
// Mirrors Renderer::renderBakedImpl + LutSampler (core/src/renderer.cpp).
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16, local_size_x_id = 16, local_size_y_id = 17) in;  // spec constants 16 / 17 = workgroup shape of the device (GLES 3.1 guarantees only 128 invocations)
#include "common.glsl"
layout(constant_id = 0) const int GEO = 0;
layout(constant_id = 1) const bool HDR = false;  // single-image HDR gain after the white balance gain (core/src/hdr_field.cpp)  // 0 identity (output pixel = source pixel), 1 exact index mapping, 2 Catmull-Rom

layout(std140, binding = 0) uniform P {
  vec4 gain;
  ivec4 a;      // srcW, srcH (full source space), dW, dH
  ivec4 b;      // bound source image origin x, y; origin of this working image in the picture x, y
  vec4 geoA;    // cs, sn, fw, fh
  vec4 geoB;    // ox0, oy0, stepX, stepY
  vec4 geoC;    // fullW, fullH, vignette, 1 = the lattice holds Display P3 encoded values (export): the vignette runs on sRGB-encoded ones
  ivec4 c;      // rot, flip, latN, toneN
  ivec4 d;      // toneBase, lat2N, 0, 0
  vec4 e;       // bakeMax, bake2Max, grain amp, grain period
  vec4 h0;      // HDR: strength, exposure EV, key EV, noise floor
  vec4 h1;      // HDR: clip luminance, grid w, h, bins
  vec4 h2;      // HDR: lmin, lstep, black end EV, top end EV
  vec4 h3;      // HDR: shadow lift peak, highlight pull (EV)
} u;

layout(binding = 1) uniform sampler2D uSrc;  // texture path: imageLoad is several times slower on Adreno
layout(binding = 2, std430) readonly buffer Tone { float tone[]; };
layout(binding = 3) uniform sampler3D uLut;
layout(binding = 4) uniform sampler3D uLut2;
layout(binding = 5, rgba16f) uniform writeonly image2D uD;
layout(binding = 6, rgba8) uniform writeonly image2D uOut8;
layout(binding = 7, std430) readonly buffer Hdr { float hdrg[]; };

// ---- single-image HDR: twin of hdr::apply / hdr::gainEv (core/src/hdr_field.cpp) -----------------------------------------------------
float hdrSmooth(float a, float b, float x) {
  const float t = clamp((x - a) / (b - a), 0.0, 1.0);
  return t * t * (3.0 - 2.0 * t);
}
vec2 hdrCell(int x, int y, int z) {
  const int gw = int(u.h1.y), gh = int(u.h1.z);
  const int i = ((z * gh + y) * gw + x) * 2;
  return vec2(hdrg[i], hdrg[i + 1]);
}
vec3 hdrApply(vec3 v, vec2 uv) {
  const float Y = dot(v, vec3(0.2880402, 0.7118741, 0.0000857));
  const float ev = u.h0.y, key = u.h0.z, yn = u.h0.w, lo = u.h2.z, hi = u.h2.w, ls = u.h3.x, hp = u.h3.y;
  const float lc0 = log2(max(Y * exp2(-ev), 1.2e-4));
  const int gw = int(u.h1.y), gh = int(u.h1.z), nb = int(u.h1.w);
  const float gx = clamp(uv.x, 0.0, 1.0) * float(gw - 1), gy = clamp(uv.y, 0.0, 1.0) * float(gh - 1);
  const float zmax = float(nb - 1);
  const float gz = clamp((lc0 - u.h2.x) / u.h2.y, 0.0, zmax);
  const int x0 = min(int(gx), gw - 2), y0 = min(int(gy), gh - 2), z0 = min(int(gz), nb - 2);
  const float fx = gx - float(x0), fy = gy - float(y0), fz = gz - float(z0);
  vec2 nd = vec2(0.0);
  for (int dz = 0; dz < 2; ++dz)
    for (int dy = 0; dy < 2; ++dy)
      for (int dx = 0; dx < 2; ++dx) {
        const float w = (dx != 0 ? fx : 1.0 - fx) * (dy != 0 ? fy : 1.0 - fy) * (dz != 0 ? fz : 1.0 - fz);
        nd += w * hdrCell(x0 + dx, y0 + dy, z0 + dz);
      }
  const float lcc = clamp(lc0, u.h2.x, u.h2.x + zmax * u.h2.y);
  const float b = (nd.x + 0.003 * lcc) / (nd.y + 0.003) + ev;
  const float L = lc0 + ev;
  // base curve with fixed ends (hdr::baseGain)
  float gl, sl = 1.0;
  if (b < key) {
    const float r = key - lo, t = clamp((b - lo) / r, 0.0, 1.0), q = 1.0 - t;
    gl = ls * 6.75 * t * q * q;
    if (b > lo) sl = 1.0 + ls * 6.75 * (q * q - 2.0 * t * q) / r;
  } else {
    const float r = hi - key, uu = clamp((b - key) / r, 0.0, 1.0);
    gl = -hp * uu * uu;
    if (b < hi) sl = 1.0 - hp * 2.0 * uu / r;
  }
  const float lyn = log2(yn);
  if (gl > 0.0) gl *= hdrSmooth(lyn, lyn + 3.0, b);
  else if (gl < 0.0) {
    const float lcl = log2(u.h1.x);
    gl *= 1.0 - hdrSmooth(lcl - 0.4, lcl - 0.03, L);
  }
  const float kc = min(0.5 * (1.0 / max(sl, 0.4) - 1.0), 0.35);
  const float det = clamp(L - b, -1.5, 1.5) * kc * hdrSmooth(lyn + 3.0, lyn + 7.0, b);
  const float g = exp2(gl + det);
  if (Y <= 1e-9) return v * g;
  float sc = 1.0;
  if (g < 1.0) sc = pow(g, 0.4 / 3.0);
  else if (g > 1.0) sc = 1.0 + (hdrSmooth(0.5 * yn, 12.0 * yn, Y) - 1.0) * min((g - 1.0) * 2.0, 1.0);
  const float Yg = g * Y;
  const float m = pow(Yg, 1.0 / 3.0), m0 = pow(Y, 1.0 / 3.0), cg = pow(g, 1.0 / 3.0);
  vec3 o = max(vec3(m) + (pow(max(v, vec3(0.0)), vec3(1.0 / 3.0)) - vec3(m0)) * sc * cg, vec3(0.0));
  o = o * o * o;
  const float lum = dot(o, vec3(0.2880402, 0.7118741, 0.0000857));
  return o * (lum > 1e-12 ? Yg / lum : 0.0);
}

vec3 srcAt(int x, int y) {
  return texelFetch(uSrc, ivec2(clamp(x, 0, u.a.x - 1), clamp(y, 0, u.a.y - 1)) - u.b.xy, 0).rgb;
}
void cubicW(float t, out float w[4]) {
  const float t2 = t * t, t3 = t2 * t;
  w[0] = -0.5 * t3 + t2 - 0.5 * t;
  w[1] = 1.5 * t3 - 2.5 * t2 + 1.0;
  w[2] = -1.5 * t3 + 2.0 * t2 + 0.5 * t;
  w[3] = 0.5 * t3 - 0.5 * t2;
}
vec3 sampleCubic(float x, float y) {
  x -= 0.5;
  y -= 0.5;
  const float fxl = floor(x), fyl = floor(y);
  const int ix = int(fxl), iy = int(fyl);
  float wx[4], wy[4];
  cubicW(x - fxl, wx);
  cubicW(y - fyl, wy);
  vec3 o = vec3(0.0);
  for (int j = 0; j < 4; ++j) {
    vec3 acc = vec3(0.0);
    for (int i = 0; i < 4; ++i) acc += wx[i] * srcAt(ix - 1 + i, iy - 1 + j);
    o += wy[j] * acc;
  }
  return max(o, vec3(0.0));
}

// Display P3 export: twins of core/src/color.h (p3ToSrgb / srgbToP3, srgbEncodeExt / srgbDecodeExt) for the vignette.
vec3 srgbDecodeExt(vec3 x) {
  const vec3 a = abs(x);
  return sign(x) * mix(a / 12.92, pow((a + 0.055) / 1.055, vec3(2.4)), greaterThan(a, vec3(0.04045)));
}
vec3 srgbEncodeExt(vec3 x) {
  const vec3 a = abs(x);
  return sign(x) * mix(a * 12.92, 1.055 * pow(a, vec3(1.0 / 2.4)) - 0.055, greaterThan(a, vec3(0.0031308)));
}
// GLSL matrices are column-major: each vec3 below is a column of the C++ matrix
const mat3 kP3ToSrgb = mat3(vec3(1.2247450, -0.0420578, -0.0196423), vec3(-0.2249043, 1.0420810, -0.0786549), vec3(0.0, 0.0, 1.0985372));
const mat3 kSrgbToP3 = mat3(vec3(0.8225929, 0.0331995, 0.0170854), vec3(0.1775340, 0.9667836, 0.0723957), vec3(0.0, 0.0, 0.9103014));

vec3 tetra(sampler3D s, vec3 x) {
  const ivec3 i = ivec3(x);
  const vec3 f = x - vec3(i);
  const bool g01 = f.x >= f.y, g02 = f.x >= f.z, g12 = f.y >= f.z;
  // axis of the largest / smallest fraction, identical tie-breaking to the CPU rank sort
  const ivec3 eMax = ivec3(g01 && g02, !g01 && g12, !g02 && !g12);
  const ivec3 eMin = ivec3(!g01 && !g02, g01 && !g12, g02 && g12);
  const ivec3 eMid = ivec3(1) - eMax - eMin;
  const float w0 = dot(f, vec3(eMax)), w1 = dot(f, vec3(eMid)), w2 = dot(f, vec3(eMin));
  const vec3 p0 = texelFetch(s, i, 0).rgb;
  const vec3 p1 = texelFetch(s, i + eMax, 0).rgb;
  const vec3 p2 = texelFetch(s, i + eMax + eMid, 0).rgb;
  const vec3 p3 = texelFetch(s, i + ivec3(1), 0).rgb;
  return p0 + w0 * (p1 - p0) + w1 * (p2 - p1) + w2 * (p3 - p2);
}

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.a.z || p.y >= u.a.w) return;
  const ivec2 q = p + u.b.zw;  // pixel of the picture
  vec3 v;
  vec2 hdrUV = (vec2(q) + 0.5) / vec2(u.a.xy);
  if (GEO == 0) {
    v = texelFetch(uSrc, q - u.b.xy, 0).rgb;
  } else {
    const float pxf = u.geoB.x + (float(q.x) + 0.5) * u.geoB.z;
    const float pyf = u.geoB.y + (float(q.y) + 0.5) * u.geoB.w;
    // Geometry::mapF: output position -> rotate 90 -> straighten -> flip -> source position
    float uu = pxf - u.geoC.x * 0.5;
    const float vv = pyf - u.geoC.y * 0.5;
    if (u.c.y != 0) uu = -uu;
    const float fx = uu * u.geoA.x + vv * u.geoA.y + u.geoA.z * 0.5;
    const float fy = -uu * u.geoA.y + vv * u.geoA.x + u.geoA.w * 0.5;
    float sx, sy;
    const float sW = float(u.a.x), sH = float(u.a.y);
    if (u.c.x == 0) { sx = fx; sy = fy; }
    else if (u.c.x == 1) { sx = fy; sy = sH - fx; }
    else if (u.c.x == 2) { sx = sW - fx; sy = sH - fy; }
    else { sx = sW - fy; sy = fx; }
    hdrUV = vec2(sx, sy) / vec2(u.a.xy);
    if (GEO == 1) v = srcAt(int(floor(sx)), int(floor(sy)));
    else v = sampleCubic(sx, sy);
  }
  v = max(v * u.gain.xyz, vec3(0.0));
  if (HDR) v = hdrApply(v, hdrUV);

  const float Y = dot(v, vec3(0.2880402, 0.7118741, 0.0000857));
  if (Y > 1e-7) {
    const uint bits = floatBitsToUint(Y);
    int k = int(bits >> 15) - u.d.x;
    float fr = float(bits & 0x7FFFu) * (1.0 / 32768.0);
    if (k < 0) { k = 0; fr = 0.0; }
    else if (k > u.c.w - 2) { k = u.c.w - 2; fr = 0.0; }
    const float t0 = tone[k];
    v *= t0 + fr * (tone[k + 1] - t0);
  }

  vec3 e;
  if (any(greaterThan(v, vec3(u.e.x)))) {
    const float sc = float(u.d.y - 1);
    e = tetra(uLut2, min(sqrt(max(v, vec3(0.0)) * (1.0 / u.e.y)) * sc, vec3(sc - 1e-4)));
  } else {
    const float sc = float(u.c.z - 1);
    e = tetra(uLut, min(sqrt(max(v, vec3(0.0)) * (1.0 / u.e.x)) * sc, vec3(sc - 1e-4)));
  }

  const float vig = u.geoC.z;
  if (vig != 0.0) {
    const float cx = u.geoC.x * 0.5, cy = u.geoC.y * 0.5;
    const float px = u.geoB.x + (float(q.x) + 0.5) * u.geoB.z - 0.5;
    const float py = u.geoB.y + (float(q.y) + 0.5) * u.geoB.w - 0.5;
    const float dx = (px - cx) / cx, dy = (py - cy) / cy;
    const float f = smoothstep(0.35, 1.05, sqrt((dx * dx + dy * dy) * 0.5));
    if (u.geoC.w > 0.5) {
      vec3 s = kP3ToSrgb * srgbDecodeExt(e);
      s = srgbEncodeExt(s);
      s = vig < 0.0 ? s * (1.0 + vig * 0.6 * f) : s + (1.0 - s) * vig * 0.6 * f;
      e = srgbEncodeExt(kSrgbToP3 * srgbDecodeExt(s));
    } else {
      e = vig < 0.0 ? e * (1.0 + vig * 0.6 * f) : e + (1.0 - e) * vig * 0.6 * f;
    }
  }
  e = clamp(e, vec3(0.0), vec3(1.0));
  if (GRAIN) e = grainApply(e, q, u.e.z, u.e.w);
  if (LAST) imageStore(uOut8, p, pack8(e));
  else imageStore(uD, p, h16v(vec4(e, 1.0)));
}
