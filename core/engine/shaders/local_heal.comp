#version 450
// Portrait retouch, heal pass (docs/engine/pipeline-architecture.md section 43): every heal spot fills its disc with the pixels of its source
// offset plus a smooth correction, the inverse-distance (Shepard) interpolation of the mismatch between 16 ring samples around the spot and the
// same samples around the source (3 x 3 means at the spot's stride). Spots composite in order; all read the input of the pass. The spot table
// (2 vec4 a spot: centre, radius, opacity / offset, stride) and the bins (32 px: start, count; then the spot indices, 4 a vec4) are in the
// frame's host-visible table buffer. Twin of local::healWindow (core/src/local_retouch.cpp).
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16, local_size_x_id = 16, local_size_y_id = 17) in;
#include "common.glsl"

layout(std140, binding = 0) uniform P {
  ivec4 dims;  // w, h, picture origin x, y
  ivec4 tab;   // spot table offset (vec4 units), spot count, bins x, bins y
  ivec4 bins;  // bin size, bin header offset, index offset (vec4 units)
  vec4 grain;  // amp, period
} u;
layout(binding = 1) uniform sampler2D uIn;
layout(binding = 2, std430) readonly buffer T { vec4 t[]; };
layout(binding = 3, rgba16f) uniform writeonly image2D uOut;
layout(binding = 4, rgba8) uniform writeonly image2D uOut8;

const vec2 kRing[16] = vec2[16](vec2(1.0, 0.0), vec2(0.9238795, 0.3826834), vec2(0.7071068, 0.7071068), vec2(0.3826834, 0.9238795),
                                vec2(0.0, 1.0), vec2(-0.3826834, 0.9238795), vec2(-0.7071068, 0.7071068), vec2(-0.9238795, 0.3826834),
                                vec2(-1.0, 0.0), vec2(-0.9238795, -0.3826834), vec2(-0.7071068, -0.7071068), vec2(-0.3826834, -0.9238795),
                                vec2(0.0, -1.0), vec2(0.3826834, -0.9238795), vec2(0.7071068, -0.7071068), vec2(0.9238795, -0.3826834));

vec3 at(ivec2 q) { return texelFetch(uIn, clamp(q, ivec2(0), u.dims.xy - ivec2(1)), 0).rgb; }
vec3 mean9(ivec2 q, int s) {
  vec3 o = vec3(0.0);
  for (int j = -1; j <= 1; ++j)
    for (int i = -1; i <= 1; ++i) o += at(q + ivec2(i, j) * s);
  return o * (1.0 / 9.0);
}
float hss(float e0, float e1, float x) {
  const float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
  return t * t * (3.0 - 2.0 * t);
}

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.dims.x || p.y >= u.dims.y) return;
  vec3 v = texelFetch(uIn, p, 0).rgb;
  const int bs = u.bins.x;
  const int bin = (p.x / bs) + (p.y / bs) * u.tab.z;
  const vec4 hd = t[u.bins.y + bin];
  const int start = int(hd.x), count = int(hd.y);
  for (int k = 0; k < count; ++k) {
    const int e = start + k;
    const int idx = int(t[u.bins.z + e / 4][e % 4]);
    const vec4 s0 = t[u.tab.x + 2 * idx], s1 = t[u.tab.x + 2 * idx + 1];
    const float cx = s0.x, cy = s0.y, R = s0.z, alpha = s0.w;
    const ivec2 o = ivec2(int(s1.x), int(s1.y));
    const int st = int(s1.z);
    const float dx = float(p.x) - cx, dy = float(p.y) - cy;
    const float dist = sqrt(dx * dx + dy * dy);
    if (dist >= R) continue;
    const float e2 = (0.1 * R) * (0.1 * R);
    float ws = 0.0;
    vec3 d = vec3(0.0);
    for (int q = 0; q < 16; ++q) {
      const ivec2 rk = ivec2(int(floor(cx + 1.15 * R * kRing[q].x + 0.5)), int(floor(cy + 1.15 * R * kRing[q].y + 0.5)));
      const vec3 dl = mean9(rk, st) - mean9(rk + o, st);
      const float ex = float(p.x - rk.x), ey = float(p.y - rk.y);
      const float wk = 1.0 / (ex * ex + ey * ey + e2);
      ws += wk;
      d += wk * dl;
    }
    const vec3 fill = at(p + o) + d / ws;
    const float a = alpha * (1.0 - hss(0.6 * R, R, dist));
    v = v + (fill - v) * a;
  }
  v = clamp(v, vec3(0.0), vec3(1.0));
  if (GRAIN) v = grainApply(v, p + u.dims.zw, u.grain.x, u.grain.y);
  if (LAST) imageStore(uOut8, p, pack8(v));
  else imageStore(uOut, p, h16v(vec4(v, 1.0)));
}
