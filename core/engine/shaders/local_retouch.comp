#version 450
// Portrait retouch, combine pass (docs/engine/pipeline-architecture.md section 43): smoothing and even tone of the mid band L_f - L_c (the high
// band Y - L_f, pores and fine hair, is never touched), redness, under-eye, shine (toward the skin reference S) and face light (a gain from
// the coarse base). L_f = 2 box passes of the luminance (sep), L_c = guided filter on the 1/4 grid applied to L_f, S = normalised convolution
// on the 1/4 grid (local_rt_down + sep). Twin of local::rtPixel (core/src/local_retouch.cpp): keep the arithmetic identical.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16, local_size_x_id = 16, local_size_y_id = 17) in;
#include "common.glsl"

layout(std140, binding = 0) uniform P {
  ivec4 dims;  // w, h, picture origin x, y
  ivec4 low;   // lw, lh
  vec4 grain;  // amp, period
  ivec4 ch;    // amount channel of smooth, even, redness, under-eye (-1 = none)
  ivec4 ch2;   // shine, face light
} u;
layout(binding = 1) uniform sampler2D uIn;
layout(binding = 2) uniform sampler2D uAux0;
layout(binding = 3) uniform sampler2D uAux1;
layout(binding = 4) uniform sampler2D uLf;
layout(binding = 5) uniform sampler2D uAb;
layout(binding = 6) uniform sampler2D uS;
layout(binding = 7, rgba16f) uniform writeonly image2D uOut;
layout(binding = 8, rgba8) uniform writeonly image2D uOut8;

float chan(int c, vec4 a0, vec4 a1) { return c < 0 ? 0.0 : c < 4 ? a0[c] : a1[c - 4]; }
float rss(float e0, float e1, float x) {
  const float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
  return t * t * (3.0 - 2.0 * t);
}
vec4 grid(sampler2D g, ivec2 p) {
  int x0, x1, y0, y1;
  float tx, ty;
  lowAxis(p.x, 4, u.low.x, x0, x1, tx);
  lowAxis(p.y, 4, u.low.y, y0, y1, ty);
  return mix(mix(texelFetch(g, ivec2(x0, y0), 0), texelFetch(g, ivec2(x1, y0), 0), tx),
             mix(texelFetch(g, ivec2(x0, y1), 0), texelFetch(g, ivec2(x1, y1), 0), tx), ty);
}

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.dims.x || p.y >= u.dims.y) return;
  vec3 c = texelFetch(uIn, p, 0).rgb;
  const vec4 a0 = texelFetch(uAux0, p, 0), a1 = texelFetch(uAux1, p, 0);
  const float k0 = chan(u.ch.x, a0, a1), k1 = chan(u.ch.y, a0, a1), k2 = chan(u.ch.z, a0, a1), k3 = chan(u.ch.w, a0, a1);
  const float k4 = chan(u.ch2.x, a0, a1), k5 = chan(u.ch2.y, a0, a1);
  if (k0 != 0.0 || k1 != 0.0 || k2 != 0.0 || k3 != 0.0 || k4 != 0.0 || k5 != 0.0) {
    const float ks = clamp(k0, 0.0, 1.0), ke = clamp(k1, 0.0, 1.0), kr = clamp(k2, 0.0, 1.0), ku = clamp(k3, 0.0, 1.0);
    const float kh = clamp(k4, 0.0, 1.0), kl = clamp(k5, 0.0, 1.0);
    const float Lf = texelFetch(uLf, p, 0).r;
    const vec2 ab = grid(uAb, p).xy;
    const float Lc = ab.x * Lf + ab.y;
    const vec4 S = grid(uS, p);
    const float Y = lumaOf(c);
    float cr = c.r - Y, cb = c.b - Y;
    float rY = Lf, rCr = cr, rCb = cb;
    if (S.w > 1e-6) {
      rY = S.x / S.w;
      rCr = S.y / S.w;
      rCb = S.z / S.w;
    }
    const float M = Lf - Lc;
    const float g = 1.0 / (1.0 + (M * 12.5) * (M * 12.5));
    float dY = -min(0.92, 0.9 * ks + 0.4 * ke) * g * M;
    if (ku > 0.0) {
      const float d = rY - (Lf + dY);
      dY += 0.8 * ku * clamp(d, 0.0, 0.25) * rss(0.0, 0.03, d);
    }
    float sg = 0.0;
    if (kh > 0.0) {
      const float e = Lf + dY - rY;
      const float chp = sqrt(cr * cr + cb * cb), chr = sqrt(rCr * rCr + rCb * rCb);
      sg = rss(0.01, 0.12, e) * (1.0 - 0.6 * rss(0.6, 1.3, chp / max(chr, 0.01)));
      dY -= 0.5 * kh * sg * max(e, 0.0);
    }
    const float far = 1.0 - rss(0.08, 0.16, sqrt((cr - rCr) * (cr - rCr) + (cb - rCb) * (cb - rCb)));
    if (ke > 0.0) {
      const float t = 0.65 * ke * far;
      cr += (rCr - cr) * t;
      cb += (rCb - cb) * t;
    }
    if (kr > 0.0) {
      const float dr = cr - rCr, db = cb - rCb;
      const float t = 0.75 * kr * far * rss(0.008, 0.04, 0.95 * dr + 0.31 * db);
      cr -= t * dr;
      cb -= t * db;
    }
    if (ku > 0.0) {
      const float t = 0.7 * ku * far;
      cr += (rCr - cr) * t;
      cb += (rCb - cb) * t;
    }
    const float Y2 = Y + dY;
    if (kh > 0.0) {
      const float t = 0.8 * kh * sg, s = clamp(Y2 / max(rY, 0.02), 0.5, 1.5);
      cr += (rCr * s - cr) * t;
      cb += (rCb * s - cb) * t;
    }
    float r = Y2 + cr, b = Y2 + cb;
    float gg = (Y2 - kLuma.r * r - kLuma.b * b) / kLuma.g;
    if (kl > 0.0) {
      const float G = 1.0 + 0.45 * kl * (1.0 - rss(0.15, 0.75, Lc)), sc = sqrt(G);
      const float Y3 = Y2 * G;
      r = Y3 + (r - Y2) * sc;
      gg = Y3 + (gg - Y2) * sc;
      b = Y3 + (b - Y2) * sc;
    }
    c = clamp(vec3(r, gg, b), vec3(0.0), vec3(1.0));
  }
  if (GRAIN) c = grainApply(c, p + u.dims.zw, u.grain.x, u.grain.y);
  if (LAST) imageStore(uOut8, p, pack8(c));
  else imageStore(uOut, p, h16v(vec4(c, 1.0)));
}
