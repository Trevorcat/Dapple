#version 450
// Dehaze, apply step (spatial.cpp dehazeImage): transmission t = 1 - omega * darkChannel / Amin is evaluated at the
// four neighbouring low-resolution samples and interpolated, then J = (I - A) / t + A. MODE 1 is the negative
// amount: a veil of light grey. The dark channel grid and the airlight are global (see the tiled export).
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16, local_size_x_id = 16, local_size_y_id = 17) in;  // spec constants 16 / 17 = workgroup shape of the device (GLES 3.1 guarantees only 128 invocations)
#include "common.glsl"
layout(constant_id = 0) const int MODE = 0;

layout(std140, binding = 0) uniform P {
  ivec4 dims;  // w, h, picture origin x, y
  ivec4 low;   // lw, lh, f, 0
  vec4 dh;     // omega, veil k, veil air, 0
  vec4 grain;  // amp, period
} u;
#ifdef ES_PINGPONG  // GLES 3.1: rgba16f images cannot be read-write -> read a sampled copy, write a different (write-only) image
layout(binding = 1, rgba16f) uniform writeonly image2D uD;
layout(binding = 5) uniform sampler2D uDin;
#define LOAD_D(p) texelFetch(uDin, (p), 0)
#else
layout(binding = 1, rgba16f) uniform image2D uD;
#define LOAD_D(p) imageLoad(uD, (p))
#endif
layout(binding = 2) uniform sampler2D uDc;
layout(binding = 3, std430) readonly buffer G { float g[]; };  // [0] max dark channel, [4..6] airlight, [7] min airlight
layout(binding = 4, rgba8) uniform writeonly image2D uOut8;

float tAt(int x, int y, float k) { return clamp(1.0 - k * texelFetch(uDc, ivec2(x, y), 0).r, 0.25, 1.0); }

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.dims.x || p.y >= u.dims.y) return;
  vec3 c = LOAD_D(p).rgb;
  const ivec2 q = p + u.dims.zw;
  if (MODE == 1) {
    c = c * (1.0 - u.dh.y) + vec3(u.dh.z * u.dh.y);
  } else {
    int x0, x1, y0, y1;
    float tx, ty;
    lowAxis(q.x, u.low.z, u.low.x, x0, x1, tx);
    lowAxis(q.y, u.low.z, u.low.y, y0, y1, ty);
    const float k = u.dh.x / g[7];
    const float a = mix(tAt(x0, y0, k), tAt(x1, y0, k), tx);
    const float b = mix(tAt(x0, y1, k), tAt(x1, y1, k), tx);
    const float inv = 1.0 / mix(a, b, ty);
    const vec3 A = vec3(g[4], g[5], g[6]);
    c = clamp((c - A) * inv + A, vec3(0.0), vec3(1.0));
  }
  if (GRAIN) c = grainApply(c, q, u.grain.x, u.grain.y);
  if (LAST) imageStore(uOut8, p, pack8(c));
  else imageStore(uD, p, h16v(vec4(c, 1.0)));
}
