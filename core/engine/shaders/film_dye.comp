#version 450
// Grain dye-cloud blur and micro-structure (mirror of the dye / micro parts of FilmGrain in core/src/film_spatial_render.cpp and
// core/engine/nodes/film/film_cpu.cpp runGrain). Planes are RGBA16F with one colour channel per component.
//   MODE 0  per-channel FIR along one axis, no boundary handling: the image is read at p + trim + k * step, so the input carries the
//           blur radius as a margin on that axis (the margin is computed from absolute coordinates, not reflected)
//           op 0 plain, op 1 out += uB (running sum of the sub-layers), op 2 out *= uB (the micro-structure multiplies the density)
//   MODE 1  log-normal hash field exp(mu + sigma z) per channel (z from the pcg3d counter hash of the ABSOLUTE coordinates)
layout(local_size_x = 16, local_size_y = 16, local_size_x_id = 16, local_size_y_id = 17) in;  // spec constants 16 / 17 = workgroup shape of the device (GLES 3.1 guarantees only 128 invocations)
float h16(float x) {
  uint u = floatBitsToUint(x);
  u += 0xFFFu + ((u >> 13) & 1u);
  return uintBitsToFloat(u & ~0x1FFFu);
}
vec4 h16v(vec4 v) { return vec4(h16(v.x), h16(v.y), h16(v.z), v.w); }

#ifndef MODE
#define MODE 0
#endif

layout(std140, binding = 0) uniform P {
  ivec4 dim;     // output w, h, op, 0
  ivec4 rad;     // MODE 0: per-channel half width (xyz); MODE 1: absolute coordinates of output pixel (0, 0) (xy)
  ivec4 tr;      // MODE 0: input offset (trim) x, y; axis step x, y
  ivec4 tp;      // MODE 0: offset (vec4 units) of the tap table in the tap buffer, vec4s per channel
  vec4 ln;       // MODE 1: mu, sigma
  uvec4 stream;  // MODE 1: per-channel stream
} u;

#if MODE == 0
layout(binding = 1) uniform sampler2D uA;
layout(binding = 2) uniform sampler2D uB;
layout(binding = 3, rgba16f) uniform writeonly image2D uOut;
layout(binding = 4, std430) readonly buffer Taps { vec4 tapv[]; };  // per channel: half taps 0..r, 4 per vec4
float tap(int c, int k) { return tapv[u.tp.x + c * u.tp.y + (k >> 2)][k & 3]; }
#else
layout(binding = 1, rgba16f) uniform writeonly image2D uOut;
void pcg3d(inout uint x, inout uint y, inout uint z) {
  x = x * 1664525u + 1013904223u;
  y = y * 1664525u + 1013904223u;
  z = z * 1664525u + 1013904223u;
  x += y * z;
  y += z * x;
  z += x * y;
  x ^= x >> 16;
  y ^= y >> 16;
  z ^= z >> 16;
  x += y * z;
  y += z * x;
  z += x * y;
}
float exp2f_(float x) {
  x = clamp(x, -125.0, 125.0);
  const float r = roundEven(x);
  const float f = x - r;
  const float p = 1.0 + f * (0.69314718 + f * (0.24022651 + f * (0.05550411 + f * (0.00961813 + f * 0.00133336))));
  return p * uintBitsToFloat(uint(int(r) + 127) << 23);
}
float logf_(float x) {  // ln(u), u in (0, 1]
  const uint b = floatBitsToUint(x);
  int e = int(b >> 23) - 127;
  float m = uintBitsToFloat((b & 0x7FFFFFu) | 0x3F800000u);
  const bool hi = m > 1.41421356;
  m = hi ? m * 0.5 : m;
  e += hi ? 1 : 0;
  const float t = (m - 1.0) / (m + 1.0), t2 = t * t;
  const float pp = 1.0 + t2 * (1.0 / 3.0 + t2 * (1.0 / 5.0 + t2 * (1.0 / 7.0 + t2 * (1.0 / 9.0))));
  return float(e) * 0.69314718 + 2.0 * t * pp;
}
float cos2pi(float t) {
  const float a = t - 0.5;
  const float aa = abs(a);
  const bool fold = aa > 0.25;
  const float b = fold ? 0.5 - aa : aa;
  const float x = 6.28318531 * b, x2 = x * x;
  const float c = 1.0 + x2 * (-0.5 + x2 * (4.16666667e-2 + x2 * (-1.38888889e-3 + x2 * (2.48015873e-5 + x2 * -2.75573192e-7))));
  return fold ? c : -c;
}
float u01(uint w) { return (float(w >> 8) + 0.5) * (1.0 / 16777216.0); }
float normalFrom(uint a, uint b) { return sqrt(-2.0 * logf_(u01(a))) * cos2pi(u01(b)); }
#endif

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.dim.x || p.y >= u.dim.y) return;
#if MODE == 0
  const ivec2 base = p + u.tr.xy, st = u.tr.zw;
  vec3 acc;
  for (int c = 0; c < 3; ++c) {
    const int r = u.rad[c];
    float a = tap(c, 0) * texelFetch(uA, base, 0)[c];
    for (int k = 1; k <= r; ++k) a += tap(c, k) * (texelFetch(uA, base - k * st, 0)[c] + texelFetch(uA, base + k * st, 0)[c]);
    acc[c] = a;
  }
  if (u.dim.z == 1) acc += texelFetch(uB, p, 0).rgb;
  else if (u.dim.z == 2) acc *= texelFetch(uB, p, 0).rgb;
  imageStore(uOut, p, h16v(vec4(acc, 1.0)));
#else
  vec3 v;
  for (int c = 0; c < 3; ++c) {
    uint w0 = uint(p.x + u.rad.x), w1 = uint(p.y + u.rad.y), w2 = u.stream[c];
    pcg3d(w0, w1, w2);
    v[c] = exp2f_((u.ln.x + u.ln.y * normalFrom(w0, w1)) * 1.44269504);
  }
  imageStore(uOut, p, h16v(vec4(v, 1.0)));
#endif
}
