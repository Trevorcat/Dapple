#version 450
// Luminance noise reduction, apply step: edge-stopped blend towards the blurred luminance (spatial.cpp denoiseLuma).
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"

layout(std140, binding = 0) uniform P {
  ivec4 dims;  // w, h, picture origin x, y
  vec4 nr;     // blend, 1 / sigma^2, grain amp, grain period
} u;
layout(binding = 1, rgba16f) uniform image2D uD;
layout(binding = 2) uniform sampler2D uYb;
layout(binding = 3, rgba8) uniform writeonly image2D uOut8;

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.dims.x || p.y >= u.dims.y) return;
  vec3 c = imageLoad(uD, p).rgb;
  const float e = lumaOf(c) - texelFetch(uYb, p, 0).r;
  const float k = u.nr.x / (1.0 + e * e * u.nr.y);
  c = clamp(c + vec3(-e * k), vec3(0.0), vec3(1.0));
  if (GRAIN) c = grainApply(c, p + u.dims.zw, u.nr.z, u.nr.w);
  if (LAST) imageStore(uOut8, p, pack8(c));
  else imageStore(uD, p, h16v(vec4(c, 1.0)));
}
