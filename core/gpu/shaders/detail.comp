#version 450
// Clarity + texture + sharpening, applied together from the same luminance (spatial.cpp detailPass). The edge-aware
// base of the clarity is the guided-filter result (a, b sampled bilinearly from the global low-resolution grid):
// base = a * Y + b. The blurred planes of texture and sharpening are produced by separable passes before this one.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"
layout(constant_id = 0) const bool CLARITY = false;
layout(constant_id = 1) const bool TEXTURE = false;
layout(constant_id = 2) const bool SHARPEN = false;

layout(std140, binding = 0) uniform P {
  ivec4 dims;   // w, h, picture origin x, y
  ivec4 low;    // lw, lh, f, 0
  vec4 gains;   // clarity gain, texture gain, texture positive (1/0), sharpen amount
  vec4 sharp;   // limit, gate, 0, 0
  vec4 grain;   // amp, period
} u;
layout(binding = 1, rgba16f) uniform image2D uD;
layout(binding = 2) uniform sampler2D uTex;      // sampled (not storage) images: Vulkan guarantees only 4 storage images per stage
layout(binding = 3) uniform sampler2D uSharp;
layout(binding = 4) uniform sampler2D uAb;
layout(binding = 5, rgba8) uniform writeonly image2D uOut8;

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= u.dims.x || p.y >= u.dims.y) return;
  const ivec2 q = p + u.dims.zw;
  vec3 c = imageLoad(uD, p).rgb;
  const float Y = lumaOf(c);
  float dY = 0.0;
  if (CLARITY) {
    int x0, x1, y0, y1;
    float tx, ty;
    lowAxis(q.x, u.low.z, u.low.x, x0, x1, tx);
    lowAxis(q.y, u.low.z, u.low.y, y0, y1, ty);
    const vec2 a = mix(mix(texelFetch(uAb, ivec2(x0, y0), 0).xy, texelFetch(uAb, ivec2(x1, y0), 0).xy, tx),
                       mix(texelFetch(uAb, ivec2(x0, y1), 0).xy, texelFetch(uAb, ivec2(x1, y1), 0).xy, tx), ty);
    const float base = a.x * Y + a.y;
    const float mid = 0.4 + 0.6 * (1.0 - (2.0 * Y - 1.0) * (2.0 * Y - 1.0));
    dY += u.gains.x * (Y - base) * mid;
  }
  if (TEXTURE) {
    const float d = Y - texelFetch(uTex, p, 0).r;
    dY += u.gains.y * (u.gains.z > 0.5 ? d / (1.0 + 10.0 * abs(d)) : d);
  }
  if (SHARPEN) {
    const float d = Y - texelFetch(uSharp, p, 0).r;
    const float a = abs(d);
    dY += u.gains.w * d * (u.sharp.x / (u.sharp.x + a)) * (a / (a + u.sharp.y));
  }
  c = clamp(c + vec3(dY), vec3(0.0), vec3(1.0));
  if (GRAIN) c = grainApply(c, q, u.grain.x, u.grain.y);
  if (LAST) imageStore(uOut8, p, pack8(c));
  else imageStore(uD, p, h16v(vec4(c, 1.0)));
}
